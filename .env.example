# API server
PORT=4000
WEB_ORIGIN=http://localhost:5174

# Frontend (Vite reads this at build time)
VITE_API_URL=http://localhost:4000

# Optional local PostgreSQL persistence. Leave DATABASE_URL unset to run in memory.
DATABASE_URL=postgresql://collab:collab_dev_password@localhost:5432/collabcode?schema=public

# Optional Gemini coding assistant (disabled unless AI_ENABLED=true).
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_COMPLEX_MODEL=gemini-3.1-pro-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_DAILY_TOKEN_LIMIT=100000
