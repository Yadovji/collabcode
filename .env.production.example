# Use letters and numbers in this password so it is safe inside DATABASE_URL.
# Replace this value before starting the deployment stack.
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_password

# Local Docker test address. For an internet server, set both values to your real HTTPS domain.
PUBLIC_ORIGIN=http://localhost:8080
PUBLIC_DOMAIN=collab.example.com

# Local browser port. On a public server, restrict this port at the firewall and use HTTPS on 443.
APP_PORT=8080
